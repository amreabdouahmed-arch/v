# Velo Search - environment template
# Copy to .env and fill in. NEVER commit the real .env.
# Every variable below is read by the Rust binary unless marked LEGACY.

# ---------------------------------------------------------------------------
# Search backend
# ---------------------------------------------------------------------------
# Which backend serves search: "tidb" (default) or "mongodb".
SEARCH_BACKEND=tidb

# ---------------------------------------------------------------------------
# TiDB / MySQL-protocol store (AUTHORITATIVE documents)
# ---------------------------------------------------------------------------
# Host and port of the TiDB (or MySQL-compatible) server.
TIDB_HOST=127.0.0.1
TIDB_PORT=4000
# User and password with read/write access to the documents table.
TIDB_USER=velo_app
TIDB_PASSWORD=change-me
# Database that holds the `search_documents` table.
TIDB_DATABASE=velo_search
# Optional path to a CA bundle for TLS. Leave empty to use the default roots.
TIDB_SSL_CA=
# LEGACY: accepted as an alias for TIDB_DATABASE.
# VELO_TIDB_DATABASE=

# ---------------------------------------------------------------------------
# MongoDB (derived indexes, crawl queue, optional search backend)
# ---------------------------------------------------------------------------
# Connection string. If it contains credentials, keep it only in .env.
MONGO_URI=mongodb://127.0.0.1:27017
# Database and collections used by the service.
MONGO_DATABASE=SearchEngine_DB
MONGO_SEARCH_COLLECTION=Crawled_Pages
MONGO_QUEUE_COLLECTION=velo_crawl_queue
# Percentage of traffic routed to MongoDB when SEARCH_BACKEND=mongodb.
MONGO_PARTITION_PERCENT=20
# LEGACY aliases: MONGODB_URI, MONGO_DB, MONGO_COLLECTION.

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Bind host and port. PORT, VELO_API_BIND and VELO_RUST_SEARCH_BIND are
# accepted as fallbacks (Docker sets PORT=7860).
API_HOST=0.0.0.0
API_PORT=8000
# Shared secret required in the X-Admin-Token header for /admin/* routes.
# Generate a long random value; never commit the real one.
ADMIN_TOKEN=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Index and ranking
# ---------------------------------------------------------------------------
# Local Tantivy index: "auto" rebuilds when empty, "off" never rebuilds.
TANTIVY_REBUILD=auto
# Cap on documents pulled from the cloud when rebuilding the Tantivy index.
TANTIVY_REBUILD_MAX_DOCUMENTS=20000
# Weight of the PageRank authority boost applied to result scores.
PAGERANK_WEIGHT=5

# ---------------------------------------------------------------------------
# Semantic search (derived, TF-IDF over TiDB/Mongo documents)
# ---------------------------------------------------------------------------
# "auto" builds at startup (default), "off" disables semantic search entirely.
SEMANTIC_MODE=auto
# "auto" builds the derived semantic index at startup (default); "off" skips the
# build so the API binds in seconds. Local dev only: semantic ranking is then
# unavailable, keyword search is unaffected.
SEMANTIC_INDEX=auto
# Cap on documents included in the semantic index build.
SEMANTIC_MAX_DOCUMENTS=20000
# Alias accepted for SEMANTIC_MAX_DOCUMENTS.
# SEMANTIC_MAX_PAGES=20000
# Minimum cosine similarity for a semantic hit to be kept (0.0 - 1.0).
SEMANTIC_MIN_SCORE=0.05

# ---------------------------------------------------------------------------
# Paths and CLI helpers
# ---------------------------------------------------------------------------
# Repo root used to locate universities.json and the UI files.
# Defaults to the detected repo root; the Dockerfile sets /app.
# VELO_PROJECT_ROOT=/app
# Base URL the manage-search CLI uses to reach a locally running API.
VELO_API_URL=http://127.0.0.1:8000
# Base URL the crawler's bulk-upload client uses (defaults to VELO_API_URL).
# VELO_API_BASE=http://127.0.0.1:8000
# Redis connection used only by the optional Celery-compatible worker config.
REDIS_URL=redis://localhost:6379/0
# Optional crawler instance name used in MongoDB metadata.
# CRAWLER_NAME=

# ---------------------------------------------------------------------------
# LEGACY - present in older deployments, NOT read by this Rust binary
# ---------------------------------------------------------------------------
# TIDB_SSL, COCKROACH_HOST, COCKROACH_PORT, COCKROACH_USER,
# COCKROACH_PASSWORD, COCKROACH_DB, COCKROACH_SSL_MODE,
# REDIS_HOST, REDIS_PORT, REDIS_DB,
# QDRANT_URL, QDRANT_API_KEY, QDRANT_COLLECTION,
# MAX_RESULTS, DEFAULT_RESULTS