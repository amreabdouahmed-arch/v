TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=velo_search
TIDB_SSL_CA=
SEARCH_BACKEND=tidb
MONGO_URI=
MONGO_DATABASE=SearchEngine_DB
MONGO_SEARCH_COLLECTION=Crawled_Pages
MONGO_PARTITION_PERCENT=20
MONGO_QUEUE_COLLECTION=velo_crawl_queue
# Aliases accepted as fallbacks: MONGO_DB (for MONGO_DATABASE), MONGO_COLLECTION (for MONGO_SEARCH_COLLECTION), MONGODB_URI (for MONGO_URI), VELO_TIDB_DATABASE (for TIDB_DATABASE)
PAGERANK_WEIGHT=5
TANTIVY_REBUILD=auto
TANTIVY_REBUILD_MAX_DOCUMENTS=20000
SEMANTIC_MODE=auto
SEMANTIC_MAX_DOCUMENTS=20000
SEMANTIC_MIN_SCORE=0.05
ADMIN_TOKEN=replace-with-a-long-random-secret
# API bind host (default 0.0.0.0)
API_HOST=0.0.0.0
# API bind port (default 8000); PORT, VELO_API_BIND and VELO_RUST_SEARCH_BIND are also accepted (Docker sets PORT=7860)
API_PORT=8000
# Repo root used to locate repo-root assets (universities.json, UI files); defaults to the detected repo root and the Dockerfile sets /app
# VELO_PROJECT_ROOT=/app
# Base URL the Python crawler CLI uses to reach the running API (localhost-only by design)
VELO_API_URL=http://127.0.0.1:8000
